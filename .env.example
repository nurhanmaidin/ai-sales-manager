# --- Database ---
# Matches docker-compose.yml service below. Run `npm run docker:up` first.
DATABASE_URL="postgresql://aisales:aisales@localhost:5432/ai_sales_manager?schema=public"

# --- Auth (NextAuth / Auth.js v5) ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- AI Provider ---
# "mock" requires no API key and is the default — the app must fully work with this.
# Swap to "openai" | "anthropic" | "ollama" later without code changes.
AI_PROVIDER="mock"
AI_API_KEY=""
AI_MODEL=""

# --- Locale ---
# "Today" / overdue calculations use this timezone.
TZ="Asia/Kuala_Lumpur"

# --- Testing ---
# Multiplies rate limits (default 1 in production, 50 in development).
# RATE_LIMIT_MULTIPLIER=""
