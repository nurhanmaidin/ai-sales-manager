// AI Sales Manager — Prisma schema
// Multi-tenant: every business entity is scoped to an Organization.
// Never trust a client-supplied organizationId — always resolve it server-side
// from the authenticated user's OrganizationMember record.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------
// Auth / Tenancy
// ------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  notificationPrefs Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships   OrganizationMember[]
  accounts      Account[]
  sessions      Session[]
  activities    Activity[]
  notes         Note[]
  aiInteractions AIInteraction[]

  @@map("users")
}

// NextAuth (Auth.js) adapter models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum OrgRole {
  OWNER
  ADMIN
  MEMBER
}

model Organization {
  id          String   @id @default(cuid())
  name        String
  businessType String?
  ownerName   String?
  phone       String?
  email       String?
  website     String?
  logoUrl     String?
  address     String?
  registrationNumber String?
  taxInfo     String?
  country     String   @default("Malaysia")
  currency    String   @default("MYR")
  description String?  @db.Text

  aiProvider  String   @default("mock")
  aiModel     String?

  onboardingCompletedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members     OrganizationMember[]
  leads       Lead[]
  customers   Customer[]
  quotations  Quotation[]
  followUps   FollowUp[]
  activities  Activity[]
  notes       Note[]
  aiInteractions AIInteraction[]

  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           OrgRole  @default(OWNER)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

// ------------------------------------------------------------------
// CRM Core
// ------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  QUOTATION_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadPriority {
  LOW
  MEDIUM
  HIGH
}

enum LeadSource {
  WHATSAPP
  WEBSITE
  FACEBOOK
  INSTAGRAM
  REFERRAL
  PHONE
  EMAIL
  OTHER
}

model Lead {
  id             String   @id @default(cuid())
  organizationId String

  name        String
  company     String?
  email       String?
  phone       String?
  source      LeadSource   @default(OTHER)
  description String?      @db.Text
  estimatedValue Decimal?  @db.Decimal(12, 2)
  status      LeadStatus   @default(NEW)
  priority    LeadPriority @default(MEDIUM)

  assignedUserId String?

  lastContactAt   DateTime?
  nextFollowUpAt  DateTime?

  convertedCustomerId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [convertedCustomerId], references: [id])
  quotations   Quotation[]
  followUps    FollowUp[]
  activities   Activity[]
  notes        Note[]
  aiInteractions AIInteraction[]

  @@index([organizationId, status])
  @@index([organizationId, priority])
  @@index([organizationId, createdAt])
  @@map("leads")
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String

  name    String
  company String?
  email   String?
  phone   String?
  address String? @db.Text
  notes   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  leadsWon     Lead[]
  quotations   Quotation[]
  followUps    FollowUp[]
  activities   Activity[]
  customerNotes Note[]

  @@index([organizationId])
  @@map("customers")
}

enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id             String   @id @default(cuid())
  organizationId String

  quotationNumber String
  title           String?
  customerId      String?
  leadId          String?

  issueDate  DateTime  @default(now())
  expiryDate DateTime?

  subtotal Decimal @default(0) @db.Decimal(12, 2)
  discount Decimal @default(0) @db.Decimal(12, 2)
  taxRate  Decimal @default(0) @db.Decimal(5, 2)
  tax      Decimal @default(0) @db.Decimal(12, 2)
  total    Decimal @default(0) @db.Decimal(12, 2)
  currency String  @default("MYR")

  notes String? @db.Text
  terms String? @db.Text

  status QuotationStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?       @relation(fields: [customerId], references: [id])
  lead         Lead?           @relation(fields: [leadId], references: [id])
  items        QuotationItem[]
  activities   Activity[]

  @@unique([organizationId, quotationNumber])
  @@index([organizationId, status])
  @@map("quotations")
}

model QuotationItem {
  id          String  @id @default(cuid())
  quotationId String
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unit        String  @default("unit")
  unitPrice   Decimal @db.Decimal(12, 2)
  total       Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@map("quotation_items")
}

enum FollowUpStatus {
  PENDING
  COMPLETED
  SNOOZED
  CANCELLED
}

model FollowUp {
  id             String   @id @default(cuid())
  organizationId String

  leadId     String?
  customerId String?

  task     String
  dueDate  DateTime
  priority LeadPriority   @default(MEDIUM)
  status   FollowUpStatus @default(PENDING)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([organizationId, status, dueDate])
  @@map("follow_ups")
}

enum ActivityType {
  LEAD_CREATED
  LEAD_UPDATED
  STATUS_CHANGED
  NOTE_ADDED
  AI_REPLY_GENERATED
  QUOTATION_CREATED
  QUOTATION_STATUS_CHANGED
  FOLLOW_UP_SCHEDULED
  FOLLOW_UP_COMPLETED
  CUSTOMER_CREATED
}

model Activity {
  id             String       @id @default(cuid())
  organizationId String
  type           ActivityType
  description    String

  leadId      String?
  customerId  String?
  quotationId String?
  userId      String?

  metadata Json?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  quotation    Quotation?   @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([leadId])
  @@map("activities")
}

model Note {
  id             String   @id @default(cuid())
  organizationId String
  content        String   @db.Text

  leadId     String?
  customerId String?
  userId     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  customer     Customer?    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([leadId])
  @@index([customerId])
  @@map("notes")
}

enum AIInteractionType {
  LEAD_REPLY
  LEAD_SUMMARY
  FOLLOW_UP_SUGGESTION
  QUOTATION_DESCRIPTION
  PIPELINE_ANALYSIS
  ASSISTANT_QUERY
}

model AIInteraction {
  id             String            @id @default(cuid())
  organizationId String
  userId         String?
  leadId         String?
  type           AIInteractionType
  prompt         String            @db.Text
  response       String            @db.Text
  provider       String
  createdAt      DateTime          @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])
  lead         Lead?        @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("ai_interactions")
}
